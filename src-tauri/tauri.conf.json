{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NanoGit",
  "version": "0.1.1",
  "identifier": "com.hulbo.nanogit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NanoGit",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "AI의 git 작업을 지켜보는 git 모니터",
    "longDescription": "AI가 한 커밋·push·reset을 실시간으로 보여 주고, push 대기 커밋과 파일 이력을 소스트리 같은 화면으로 확인하는 가벼운 git 모니터",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
